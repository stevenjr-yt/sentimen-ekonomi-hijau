{
  "version": 2,
  "name": "sentimentgreen",
  "public": true,
  "outputDirectory": "web",
  "buildCommand": "",
  "framework": null,
  "headers": [
    {
      "source": "/downloads/(.*\\.pdf)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
