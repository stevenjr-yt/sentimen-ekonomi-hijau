{
  "version": 2,
  "public": true,
  "outputDirectory": "web",
  "framework": null,
  "headers": [
    {
      "source": "/downloads/(.*\\.pdf)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ]
}
